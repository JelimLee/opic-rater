# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
#
# Only `opic grade --engine api` reads this. Transcription and segmentation are
# fully local and need no key at all; `--engine prompts` needs none either.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
